def version = "0.0.0"
def packageName = "GTestAllureUtilities"
def testApplications = ["UnitTest","IntegrationTest"]
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']

library identifier: "cpp-jenkins-pipelines@master", retriever: modernSCM(
  [$class: "GitSCMSource",
   remote: "https://github.com/systelab/cpp-jenkins-pipelines.git"])
   
pipeline
{
	agent
	{
		label 'libGen-conan2'
	}

	parameters
	{
		booleanParam( name: 'uploadTestingPkg',
					  description: 'Whether or not to upload testing conan package',
					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				deleteDir()
				checkoutSourceCode()
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								def buildFolder = "build-${config}-${arch}"
								bat "conan install . --output-folder ${buildFolder} -pr:a ${profile} -s:h build_type=${config} -s:b build_type=${config} -s:h arch=${arch}"
								bat "conan build . --output-folder ${buildFolder} -pr:a ${profile} -s:h build_type=${config} -s:b build_type=${config} -s:h arch=${arch}"
								bat "conan export-pkg . --version ${version} --output-folder ${buildFolder} -pr:a ${profile} -s:h build_type=${config} -s:b build_type=${config} -s:h arch=${arch}"
								dir("${buildFolder}/bin/${config}")
								{
									testApplications.each
									{ testApplication ->
										bat "${testApplication}.exe --gtest_output=xml:${env.WORKSPACE}\\${buildFolder}\\test_reports\\${testApplication}.xml"
									}
								}
							}
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { return params.uploadTestingPkg }
			}
			steps
			{
				bat "conan upload ${packageName}/${version} -r aid-conan-production-local --confirm"
			}
		}
	}

	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build*/test_reports/*.xml"
		}
	}
}
